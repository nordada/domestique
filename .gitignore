# Holds live secrets (Plex token, Discord webhook URL) once seeded/edited via
# the web UI - never commit it, unlike config/events.json.
config/settings.json
# Runtime activity log, host-specific and constantly changing - not
# something to track in git, unlike config/events.json.
config/activity.json
# Records deduped torrents' pre-relink locations (see src/dedupeState.ts) -
# runtime state, same as activity.json above, not something to track in git.
config/dedupe-state.json
# Durable copy of every .torrent successfully staged through the Reseed tab
# (see src/torrentRegistry.ts) - runtime state, host-specific, not something
# to track in git.
config/torrent-registry/
